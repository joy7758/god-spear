{
  "name": "god-spear",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "bin": {
    "spear": "bin/spear.js",
    "create-pfdo-secure": "bin/create-pfdo-secure.js"
  },
  "files": [
    "bin/",
    "lib/",
    "spear/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "spear:check:ok": "node bin/spear.js check examples/rules.ok.json --trace spear/traces/trace.jsonl",
    "spear:check:fail": "node bin/spear.js check examples/rules.fail.json --trace spear/traces/trace.jsonl",
    "spear:trace:verify": "node bin/spear.js trace verify spear/traces/trace.jsonl",
    "spear:check": "node bin/spear.js check .spear-rules.json --trace spear/traces/trace.jsonl --out spear/reports",
    "spear:check:default": "node bin/spear.js check --trace spear/traces/trace.jsonl --out spear/reports"
  },
  "license": "MIT"
}
